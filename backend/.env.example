# Local development against the Firebase emulators (no credentials needed).
PORT=3000
FIREBASE_PROJECT_ID=demo-gym-tracker
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
CORS_ORIGINS=http://localhost:4200,http://localhost:4300

# For a real Firebase project instead of the emulators:
#   1. Set FIREBASE_PROJECT_ID to your project id.
#   2. Remove FIRESTORE_EMULATOR_HOST and FIREBASE_AUTH_EMULATOR_HOST.
#   3. Set FIREBASE_KEY_FILE to the path of a service-account key file (never commit it).
